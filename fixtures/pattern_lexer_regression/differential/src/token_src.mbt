///|
#loom.token
pub(all) enum Token {
  #loom.literal
  #loom.pattern("(!)")
  #loom.payload("record_payload($0.to_owned())")
  PayloadShort(String)
  #loom.literal
  #loom.pattern("(!!)")
  #loom.payload("record_payload($0.to_owned())")
  PayloadLong(String)
  #loom.keyword("let")
  Let
  #loom.ident
  #loom.pattern("[a-zA-Z_][a-zA-Z0-9_]*")
  Ident
  #loom.literal
  #loom.custom_lex("custom_first")
  CustomFirst
  #loom.literal
  #loom.custom_lex("custom_second")
  CustomSecond
  #loom.punct("-")
  Minus
  #loom.punct("->")
  Arrow
  #loom.literal
  #loom.pattern("~+")
  TieFirst
  #loom.literal
  #loom.pattern("~+")
  TieSecond
  #loom.literal
  #loom.pattern("a[0-9]+")
  CandidateA
  #loom.literal
  #loom.pattern("b[0-9]+")
  CandidateB
  #loom.literal
  #loom.pattern("c[0-9]+")
  CandidateC
  #loom.literal
  #loom.pattern("d[0-9]+")
  CandidateD
  #loom.literal
  #loom.pattern("e[0-9]+")
  CandidateE
  #loom.literal
  #loom.pattern("f[0-9]+")
  CandidateF
  #loom.literal
  #loom.pattern("g[0-9]+")
  CandidateG
  #loom.literal
  #loom.pattern("h[0-9]+")
  CandidateH
  #loom.literal
  #loom.pattern("i[0-9]+")
  CandidateI
  #loom.literal
  #loom.pattern("j[0-9]+")
  CandidateJ
  #loom.literal
  #loom.pattern("k[0-9]+")
  CandidateK
  #loom.literal
  #loom.pattern("l[0-9]+")
  CandidateL
  #loom.literal
  #loom.pattern("m[0-9]+")
  CandidateM
  #loom.literal
  #loom.pattern("n[0-9]+")
  CandidateN
  #loom.literal
  #loom.pattern("o[0-9]+")
  CandidateO
  #loom.eof
  EOF
} derive(Eq, Debug)
