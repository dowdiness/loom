///|
fn commonmark_html_fixture_cases() -> Array[CommonMarkHtmlFixture] {
  let fixtures : Array[CommonMarkHtmlFixture] = [
    {
      example: 196,
      section: "Link reference definitions",
      name: "arbitrarily-multiline-reference-title",
      source: "[foo]: /url '\ntitle\nline1\nline2\n'\n\n[foo]\n",
      expected_html: "<p><a href=\"/url\" title=\"\ntitle\nline1\nline2\n\">foo</a></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 207,
      section: "Link reference definitions",
      name: "reference-definition-only-document",
      source: "[foo]: /url\n",
      expected_html: "",
      status: CommonMarkHtmlPass,
    },
    {
      example: 208,
      section: "Link reference definitions",
      name: "multiline-reference-label-leaves-following-flow",
      source: "[\nfoo\n]: /url\nbar\n",
      expected_html: "<p>bar</p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 317,
      section: "Lists",
      name: "list-contained-reference-definition",
      source: "- a\n- b\n\n  [ref]: /url\n- d\n",
      expected_html: "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n<li>\n<p>d</p>\n</li>\n</ul>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 62,
      section: "ATX headings",
      name: "atx-heading-levels",
      source: "# foo\n## foo\n### foo\n#### foo\n##### foo\n###### foo\n",
      expected_html: "<h1>foo</h1>\n<h2>foo</h2>\n<h3>foo</h3>\n<h4>foo</h4>\n<h5>foo</h5>\n<h6>foo</h6>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 4,
      section: "Tabs",
      name: "tabs-list-continuation-paragraph-after-blank",
      source: "  - foo\n\n\tbar\n",
      expected_html: "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 5,
      section: "Tabs",
      name: "tabs-list-indented-code-block-after-blank",
      source: "- foo\n\n\t\tbar\n",
      expected_html: "<ul>\n<li>\n<p>foo</p>\n<pre><code>  bar\n</code></pre>\n</li>\n</ul>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 6,
      section: "Tabs",
      name: "tabs-blockquote-indented-code-block",
      source: ">\t\tfoo\n",
      expected_html: "<blockquote>\n<pre><code>  foo\n</code></pre>\n</blockquote>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 7,
      section: "Tabs",
      name: "tabs-list-indented-code-block-initial-line",
      source: "-\t\tfoo\n",
      expected_html: "<ul>\n<li>\n<pre><code>  foo\n</code></pre>\n</li>\n</ul>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 9,
      section: "Tabs",
      name: "tabs-nested-list-marker-after-tab",
      source: " - foo\n   - bar\n\t - baz\n",
      expected_html: "<ul>\n<li>foo\n<ul>\n<li>bar\n<ul>\n<li>baz</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 10,
      section: "Tabs",
      name: "tabs-atx-heading-separator",
      source: "#\tFoo\n",
      expected_html: "<h1>Foo</h1>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 119,
      section: "Fenced code blocks",
      name: "fenced-code-escapes-html",
      source: "```\n<\n >\n```\n",
      expected_html: "<pre><code>&lt;\n &gt;\n</code></pre>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 219,
      section: "Paragraphs",
      name: "paragraphs-separated-by-blank-line",
      source: "aaa\n\nbbb\n",
      expected_html: "<p>aaa</p>\n<p>bbb</p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 328,
      section: "Code spans",
      name: "inline-code",
      source: "`foo`\n",
      expected_html: "<p><code>foo</code></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 329,
      section: "Code spans",
      name: "code-spans-329-unequal-interior-run",
      source: "`` foo ` bar ``\n",
      expected_html: "<p><code>foo ` bar</code></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 331,
      section: "Code spans",
      name: "code-spans-331-boundary-space-trim",
      source: "`  ``  `\n",
      expected_html: "<p><code> `` </code></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 334,
      section: "Code spans",
      name: "code-spans-334-all-space-preservation",
      source: "` `\n`  `\n",
      expected_html: "<p><code> </code>\n<code>  </code></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 335,
      section: "Code spans",
      name: "code-spans-335-multiline-normalization",
      source: "``\nfoo\nbar  \nbaz\n``\n",
      expected_html: "<p><code>foo bar   baz</code></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 482,
      section: "Links",
      name: "links-482-inline-title",
      source: "[link](/uri \"title\")\n",
      expected_html: "<p><a href=\"/uri\" title=\"title\">link</a></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 488,
      section: "Links",
      name: "links-488-invalid-space-in-destination-is-literal",
      source: "[link](/my uri)\n",
      expected_html: "<p>[link](/my uri)</p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 527,
      section: "Links",
      name: "links-527-full-reference",
      source: "[foo][bar]\n\n[bar]: /url \"title\"\n",
      expected_html: "<p><a href=\"/url\" title=\"title\">foo</a></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 553,
      section: "Links",
      name: "links-553-collapsed-reference",
      source: "[foo][]\n\n[foo]: /url \"title\"\n",
      expected_html: "<p><a href=\"/url\" title=\"title\">foo</a></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 544,
      section: "Links",
      name: "links-544-first-definition-wins",
      source: "[foo]: /url1\n\n[foo]: /url2\n\n[bar][foo]\n",
      expected_html: "<p><a href=\"/url1\">bar</a></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 545,
      section: "Links",
      name: "links-545-unresolved-reference-is-literal",
      source: "[bar][foo\\!]\n\n[foo!]: /url\n",
      expected_html: "<p>[bar][foo!]</p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 546,
      section: "Links",
      name: "links-546-invalid-nested-reference-is-literal",
      source: "[foo][ref[]\n\n[ref[]: /uri\n",
      expected_html: "<p>[foo][ref[]</p>\n<p>[ref[]: /uri</p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 557,
      section: "Links",
      name: "links-557-shortcut-reference",
      source: "[foo]\n\n[foo]: /url \"title\"\n",
      expected_html: "<p><a href=\"/url\" title=\"title\">foo</a></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 572,
      section: "Images",
      name: "images-572-inline-title",
      source: "![foo](/url \"title\")\n",
      expected_html: "<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 483,
      section: "Links",
      name: "inline-link",
      source: "[link](/uri)\n",
      expected_html: "<p><a href=\"/uri\">link</a></p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 607,
      section: "Autolinks",
      name: "angle-brackets-as-text",
      source: "<>\n",
      expected_html: "<p>&lt;&gt;</p>\n",
      status: CommonMarkHtmlPass,
    },
    {
      example: 650,
      section: "Textual content",
      name: "textual-content-punctuation",
      source: "hello $.;'there\n",
