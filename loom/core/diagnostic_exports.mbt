///|
// Parser-independent diagnostic API, re-exported for Loom consumers.
pub using @diagnostic {
  type DiagnosticBuildError,
  type DiagnosticCode,
  type DiagnosticFix,
  type DiagnosticFixError,
  type DiagnosticLabel,
  type DiagnosticOrigin,
  type DiagnosticRenderError,
  type DiagnosticSeverity,
  type Diagnostic,
  type FixApplicability,
  type LabelStyle,
  type LineCol,
  type LineIndex,
  type LineRange,
  type SourceId,
  type SourceSnapshot,
  type SourceSpan,
  type TextOffset,
  type TextRange,
  type TextReplacement,
  trait SourceResolver,
  trait TextDisplay,
  trait ToDiagnostic,
  render_diagnostics_plain,
  render_diagnostics_plain_with_display,
}
