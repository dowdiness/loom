pub fn[T] TokenBuffer::new(@diagnostic.SourceId, String, tokenize_fn~ : (String) -> Array[TokenInfo[T]] raise LexError, eof_token~ : T) -> Self[T] raise LexError
pub fn[T : Eq] TokenBuffer::new_from_lex(@diagnostic.SourceId, String, lex_fn~ : (String) -> LexResult[T], eof_token~ : T, incremental_relex_enabled? : Bool) -> Self[T]
pub fn[T : Eq] TokenBuffer::new_from_mode_relex(@diagnostic.SourceId, String, factory~ : ModeRelexFactory[T], eof_token~ : T) -> Self[T]
pub fn[T] TokenBuffer::new_from_steps(@diagnostic.SourceId, String, PrefixLexer[T], eof_token~ : T, error_token~ : T, error_token_from_message? : ((String) -> T)?) -> Self[T]
pub fn[T] TokenBuffer::new_from_steps_strict(@diagnostic.SourceId, String, PrefixLexer[T], eof_token~ : T) -> Self[T] raise LexError
#deprecated
pub fn[T] TokenBuffer::new_resilient(@diagnostic.SourceId, String, tokenize_fn~ : (String) -> Array[TokenInfo[T]] raise LexError, eof_token~ : T, error_token~ : T) -> Self[T]
pub fn[T] TokenBuffer::new_resilient_compat(@diagnostic.SourceId, String, tokenize_fn~ : (String) -> Array[TokenInfo[T]] raise LexError, eof_token~ : T, error_token~ : T) -> Self[T]
pub fn[T] TokenBuffer::set_goal_step(Self[T], (String, Int, Int) -> LexStep[T]) -> Unit
pub fn[T] TokenBuffer::token_count(Self[T]) -> Int
pub fn[T] TokenBuffer::tokenize_at_offset(Self[T], Int, Int) -> LexStep[T]
pub fn[T : Eq] TokenBuffer::update(Self[T], Edit, String) -> Unit raise LexError

pub struct TokenInfo[T] {
  token : T
  len : Int
} derive(Eq, @debug.Debug)
pub fn[T] TokenInfo::new(T, Int) -> Self[T]

// Type aliases
pub using @diagnostic {type Diagnostic}

pub using @diagnostic {type DiagnosticBuildError}

pub using @diagnostic {type DiagnosticCode}

pub using @diagnostic {type DiagnosticFix}

pub using @diagnostic {type DiagnosticFixError}

pub using @diagnostic {type DiagnosticLabel}

pub using @diagnostic {type DiagnosticOrigin}

pub using @diagnostic {type DiagnosticRenderError}

pub using @diagnostic {type DiagnosticSeverity}

pub using @diagnostic {type FixApplicability}

pub using @diagnostic {type LabelStyle}

pub using @diagnostic {type LineCol}

pub using @diagnostic {type LineIndex}

pub using @diagnostic {type LineRange}

pub using @diagnostic {type SourceId}

pub using @diagnostic {type SourceSnapshot}

pub using @diagnostic {type SourceSpan}

pub using @diagnostic {type TextOffset}

pub using @diagnostic {type TextRange}

pub using @diagnostic {type TextReplacement}

pub using @seam {trait AstView}

pub using @diagnostic {trait SourceResolver}

pub using @diagnostic {trait TextDisplay}

pub using @diagnostic {trait ToDiagnostic}

// Traits
pub(open) trait Canonical {
  fn canonical(Self) -> Self
}

pub trait Editable {
  fn start(Self) -> Int
  fn old_len(Self) -> Int
  fn new_len(Self) -> Int
}

pub(open) trait Renderable {
  fn kind_tag(Self) -> String
  fn label(Self) -> String
  fn placeholder(Self) -> String
  fn unparse(Self) -> String
}

pub(open) trait TreeNode {
  fn children(Self) -> Array[Self]
  fn same_kind(Self, Self) -> Bool
}
